# Токен бота от @BotFather
BOT_TOKEN=

# Telegram ID администраторов через запятую (узнать свой ID: @userinfobot).
# Им приходят новые заказы, доступны /orders, /orders_new, /reload и смена статусов.
ADMIN_IDS=

# Необязательно: ID группы, куда дублировать заказы (бот должен быть её участником), например -1001234567890
ORDERS_CHAT_ID=

# Appwrite на сервере (консоль: http://IP_СЕРВЕРА). Замените 203.0.113.10 на IP вашего сервера.
APPWRITE_ENDPOINT=https://203.0.113.10/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
# true — принимать самоподписанный SSL-сертификат (при доступе по IP настоящего сертификата нет)
APPWRITE_SELF_SIGNED=true

# Через сколько секунд правки товаров в Appwrite появятся в боте
CATALOG_TTL_SECONDS=60

# Валюта цен
CURRENCY=сум
